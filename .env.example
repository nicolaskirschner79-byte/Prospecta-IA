# Preencher somente no ambiente privado do servidor. Nunca incluir segredos no Git.
PORT=3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Alternativa para instalação de um único usuário, sem Supabase Auth:
APP_ACCESS_KEY=
# Busca externa é opt-in; exige contato de identificação e autenticação acima.
ENABLE_OSM=false
PROVIDER_CONTACT=
# Auditoria limitada a domínios autorizados, separados por vírgula, sem protocolo.
AUDIT_ALLOWED_HOSTS=
# API opcional para auditoria mobile, com quota própria.
PAGESPEED_API_KEY=
