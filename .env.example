# Opcional: esta instalação já funciona sem arquivo .env.local.
# Somente preencha para mudar os padrões. Nunca inclua segredos no Git.
PORT=3000
# Por padrão, usa o projeto Prospecta IA já conectado no código.
# Para outro projeto, informe URL e chave publicável juntas:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# DISABLE_CLOUD=true
# APP_ACCESS_KEY=  # acesso individual, opcional, substitui login nas consultas
# ENABLE_OSM=false  # somente para desativar a busca
# PROVIDER_CONTACT=https://github.com/nicolaskirschner79-byte/Prospecta-IA
# AUDIT_MODE=disabled
# AUDIT_ALLOWED_HOSTS=  # opcional: restringe a auditoria a estes domínios
# PAGESPEED_API_KEY=  # somente se desejar a medição Lighthouse opcional
